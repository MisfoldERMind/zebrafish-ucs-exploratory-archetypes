apply_author_reference_robust_z <- function(
    data_frame,
    parameter_table,
    object_name
) {
  transformed_data <- data_frame

  for (robust_variable_i in robust_variables) {
    transformed_data[[robust_variable_i]] <- NA_real_
  }

  for (parameter_row in seq_len(nrow(parameter_table))) {
    author_i <- parameter_table$Author[parameter_row]
    variable_i <- parameter_table$Variable[parameter_row]
    robust_variable_i <- paste0(variable_i, "_rz")
    author_rows <- as.character(data_frame$Author) == author_i

    if (!any(author_rows)) {
      stop(
        object_name,
        " contains no observations for Author ",
        author_i,
        "."
      )
    }

    transformed_data[[robust_variable_i]][author_rows] <- (
      data_frame[[variable_i]][author_rows] -
        parameter_table$Median[parameter_row]
    ) / parameter_table$MAD_scaled[parameter_row]
  }

  if (
    !identical(
      data_frame[identifier_variables],
      transformed_data[identifier_variables]
    )
  ) {
    stop(
      "Author + ID identity or row order changed during normalisation of ",
      object_name,
      "."
    )
  }

  transformed_matrix <- as.matrix(
    transformed_data[robust_variables]
  )

  storage.mode(transformed_matrix) <- "double"

  if (any(!is.finite(transformed_matrix))) {
    stop(
      "Normalisation generated missing or non-finite values in ",
      object_name,
      "."
    )
  }

  transformed_data
}

