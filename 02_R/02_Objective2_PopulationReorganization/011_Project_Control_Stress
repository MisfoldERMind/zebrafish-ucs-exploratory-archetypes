order_by_key <- function(data_frame) {
  data_frame %>%
    dplyr::mutate(
      Author_key = as.character(Author),
      ID_key = as.character(ID)
    ) %>%
    dplyr::arrange(
      Author_key,
      ID_key
    ) %>%
    dplyr::select(
      -Author_key,
      -ID_key
    )
}

compare_keyed_data <- function(
    observed,
    expected,
    variables,
    observed_name,
    expected_name,
    tolerance = comparison_tolerance
) {
  observed_ordered <- order_by_key(observed)
  expected_ordered <- order_by_key(expected)

  observed_keys <- data.frame(
    Author = as.character(observed_ordered$Author),
    ID = as.character(observed_ordered$ID),
    stringsAsFactors = FALSE
  )

  expected_keys <- data.frame(
    Author = as.character(expected_ordered$Author),
    ID = as.character(expected_ordered$ID),
    stringsAsFactors = FALSE
  )

  if (!identical(observed_keys, expected_keys)) {
    stop(
      observed_name,
      " and ",
      expected_name,
      " do not contain the same Author + ID keys."
    )
  }

  observed_matrix <- as.matrix(
    observed_ordered[variables]
  )

  expected_matrix <- as.matrix(
    expected_ordered[variables]
  )

  storage.mode(observed_matrix) <- "double"
  storage.mode(expected_matrix) <- "double"

  comparison_result <- all.equal(
    observed_matrix,
    expected_matrix,
    tolerance = tolerance,
    check.attributes = FALSE
  )

  if (!isTRUE(comparison_result)) {
    stop(
      observed_name,
      " and ",
      expected_name,
      " differ in the compared variables.\n",
      paste(comparison_result, collapse = "\n")
    )
  }

  invisible(TRUE)
}

