# 11. Audit normalisation within every Author x group x variable
# ------------------------------------------------------------

summarise_robust_variable <- function(
    data_frame,
    group_name,
    author_name,
    original_variable
) {
  robust_variable <- paste0(
    original_variable,
    "_rz"
  )

  rows_i <-
    as.character(data_frame$Treatment) == group_name &
    as.character(data_frame$Author) == author_name

  values <- data_frame[[robust_variable]][rows_i]
  centre <- stats::median(values)

  tibble::tibble(
    Group = group_name,
    Author = author_name,
    Variable = original_variable,
    Robust_variable = robust_variable,
    n = length(values),
    Mean = mean(values),
    SD = stats::sd(values),
    Median = centre,
    Q1 = as.numeric(
      stats::quantile(
        values,
        probs = 0.25,
        names = FALSE,
        type = 7
      )
    ),
    Q3 = as.numeric(
      stats::quantile(
        values,
        probs = 0.75,
        names = FALSE,
        type = 7
      )
    ),
    IQR = stats::IQR(values),
    MAD_scaled = stats::mad(
      values,
      center = centre,
      constant = mad_scale_constant
    ),
    Minimum = min(values),
    Maximum = max(values)
  )
}

