check_required_columns <- function(
    data_frame,
    required_columns,
    object_name
) {
  missing_columns <- setdiff(
    required_columns,
    names(data_frame)
  )

  if (length(missing_columns) > 0L) {
    stop(
      object_name,
      " is missing the following columns:\n",
      paste(missing_columns, collapse = ", ")
    )
  }
}

check_identifier_integrity <- function(
    data_frame,
    object_name
) {
  identifier_data <- data_frame[
    identifier_variables
  ]

  if (anyNA(identifier_data)) {
    stop(
      "Missing identifier values were found in ",
      object_name,
      "."
    )
  }

  blank_identifier <- vapply(
    identifier_data,
    function(x) any(trimws(as.character(x)) == ""),
    logical(1)
  )

  if (any(blank_identifier)) {
    stop(
      "Blank values were found in ",
      object_name,
      " for: ",
      paste(
        names(blank_identifier)[blank_identifier],
        collapse = ", "
      ),
      "."
    )
  }

  duplicate_key <- duplicated(
    data.frame(
      Author = as.character(data_frame$Author),
      ID = as.character(data_frame$ID),
      stringsAsFactors = FALSE
    )
  )

  if (any(duplicate_key)) {
    stop(
      "Duplicated Author + ID keys were found in ",
      object_name,
      " at row(s): ",
      paste(which(duplicate_key), collapse = ", "),
      "."
    )
  }
}

check_numeric_finite <- function(
    data_frame,
    variables,
    object_name
) {
  non_numeric_variables <- variables[
    !vapply(
      data_frame[variables],
      is.numeric,
      logical(1)
    )
  ]

  if (length(non_numeric_variables) > 0L) {
    stop(
      "The following variables are not numeric in ",
      object_name,
      ":\n",
      paste(non_numeric_variables, collapse = ", ")
    )
  }

  non_finite_variables <- variables[
    vapply(
      data_frame[variables],
      function(x) any(!is.finite(x)),
      logical(1)
    )
  ]

  if (length(non_finite_variables) > 0L) {
    stop(
      "The following variables contain missing or non-finite values in ",
      object_name,
      ":\n",
      paste(non_finite_variables, collapse = ", ")
    )
  }
}

