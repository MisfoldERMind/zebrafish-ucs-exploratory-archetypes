# Independently recalculate the parameters from control.rds and
# require exact numerical agreement with the saved Objective 1 object.

recalculated_parameters <- dplyr::bind_rows(
  lapply(
    control_authors,
    function(author_i) {
      author_rows <- as.character(control_reference$Author) == author_i

      dplyr::bind_rows(
        lapply(
          behavioural_variables,
          function(variable_i) {
            values <- control_reference[[variable_i]][author_rows]
            centre <- stats::median(values)
            mad_raw <- stats::mad(
              values,
              center = centre,
              constant = 1
            )

            tibble::tibble(
              Author = author_i,
              Variable = variable_i,
              n = length(values),
              Median = centre,
              MAD_raw = mad_raw,
              MAD_scaled = mad_scale_constant * mad_raw
            )
          }
        )
      )
    }
  )
) %>%
  dplyr::arrange(
    Author,
    match(Variable, behavioural_variables)
  )

parameter_comparison <- all.equal(
  as.data.frame(parameters),
  as.data.frame(recalculated_parameters),
  tolerance = comparison_tolerance,
  check.attributes = FALSE
)

